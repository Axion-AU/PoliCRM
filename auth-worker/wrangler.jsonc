{
  "name": "policrm-auth-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "policrm-auth-db",
      "database_id": "policrm-auth-db"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "policrm-auth-kv",
      "preview_id": "policrm-auth-kv"
    }
  ],
  "vars": {
    "BACKEND_URL": "http://localhost:8080",
    "BETTER_AUTH_URL": "http://localhost:8787"
  }
}
